  <!-- ALERTA FLOTANTE (TOAST) -->
  <div *ngIf="mensajeAlerta"
       class="fixed top-6 right-6 z-50 flex items-center gap-2.5 px-4 py-2.5 rounded-lg shadow-md border text-xs font-medium transition-all animate-in fade-in slide-in-from-top-4 duration-300"
       [ngClass]="tipoAlerta === 'success' ? 'bg-emerald-50 text-emerald-800 border-emerald-200' : 'bg-rose-50 text-rose-800 border-rose-200'">
    <i class="text-sm" [ngClass]="tipoAlerta === 'success' ? 'fa-solid fa-circle-check text-emerald-600' : 'fa-solid fa-circle-exclamation text-rose-600'"></i>
    <span>{{ mensajeAlerta }}</span>
  </div>

  <!-- MODAL FLOTANTE (CREAR / EDITAR) -->
  <div *ngIf="mostrarModal" class="fixed inset-0 z-50 h-screen w-screen flex items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4 overflow-y-auto">
    <div class="bg-white rounded-xl shadow-xl border border-slate-200/60 w-full max-w-md overflow-hidden my-auto animate-in fade-in zoom-in duration-200">

      <!-- Cabecera del Modal -->
      <div class="px-5 py-3.5 border-b border-slate-100 flex justify-between items-center bg-white">
        <h2 class="text-sm font-semibold text-slate-900">
          {{ editando ? 'Editar Usuario' : 'Nuevo Usuario' }}
        </h2>
        <button (click)="cerrarModal()" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-slate-600 rounded-md transition-colors">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <!-- Formulario dentro del Modal -->
      <form (ngSubmit)="guardarUsuario()" class="p-5 space-y-3.5">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Nombre</label>
          <input type="text" [(ngModel)]="usuarioForm.nombre" name="nombre" required placeholder="Nombre completo"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-slate-50/50 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all">
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Email</label>
          <input type="email" [(ngModel)]="usuarioForm.email" name="email" required placeholder="correo@ejemplo.com"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-slate-50/50 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all">
        </div>

        <div *ngIf="!editando">
          <label class="block text-xs font-medium text-slate-500 mb-1">Contraseña</label>
          <input type="password" [(ngModel)]="usuarioForm.password" name="password" required placeholder="••••••••"
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-slate-50/50 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all">
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Rol</label>
          <select [(ngModel)]="usuarioForm.rol_id" name="rol_id" required
            class="w-full px-3 py-2 border border-slate-200 rounded-lg text-xs bg-slate-50/50 focus:bg-white focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all">
            <option value="" disabled selected>Seleccionar rol</option>
            <option *ngFor="let rol of roles" [value]="rol.id">{{ rol.nombre }}</option>
          </select>
        </div>

        <!-- Botones de Acción del Modal -->
        <div class="flex justify-end gap-2 pt-3 border-t border-slate-100 mt-4">
          <button type="button" (click)="cerrarModal()"
            class="px-3.5 py-2 text-xs font-medium text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            Cancelar
          </button>
          <button type="submit"
            class="px-4 py-2 text-xs font-medium text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors">
            {{ editando ? 'Guardar cambios' : 'Crear usuario' }}
          </button>
        </div>
      </form>

    </div>
  </div>

  <app-confirmation-dialog
    [open]="!!usuarioAEliminar || confirmacionEdicion"
    [title]="usuarioAEliminar ? 'Eliminar usuario' : 'Confirmar edición'"
    [message]="usuarioAEliminar
      ? 'Esta acción es permanente. Confirma el nombre de la cuenta que vas a eliminar.'
      : '¿Deseas guardar los cambios realizados a este usuario?'"
    [details]="usuarioAEliminar
      ? usuarioAEliminar.nombre + ' · ' + usuarioAEliminar.email
      : usuarioForm.nombre + ' · ' + usuarioForm.email"
    [confirmLabel]="usuarioAEliminar
      ? (eliminandoUsuario ? 'Eliminando…' : 'Eliminar usuario')
      : (actualizandoUsuario ? 'Guardando…' : 'Guardar cambios')"
    [confirmationText]="usuarioAEliminar?.nombre ?? null"
    [confirmationPrompt]="usuarioAEliminar
      ? 'Escribe ' + usuarioAEliminar.nombre + ' para confirmar'
      : ''"
    [(confirmationValue)]="nombreConfirmacionEliminacion"
    [tone]="usuarioAEliminar ? 'danger' : 'primary'"
    [busy]="eliminandoUsuario || actualizandoUsuario"
    (confirmed)="confirmarAccion()"
    (cancelled)="cerrarConfirmacion()">
  </app-confirmation-dialog>

  <!-- TABLA DE USUARIOS -->
  <div class="bg-white rounded-xl shadow-xs border border-slate-200/70 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100 flex justify-between items-center">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-semibold text-slate-900">Usuarios</h2>
        <span class="text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-medium">
          {{ usuarios.length }}
        </span>
      </div>
      <button (click)="abrirModalCrear()"
        class="px-3.5 py-2 text-xs font-medium text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors flex items-center gap-1.5 shadow-xs">
        <i class="fa-solid fa-plus text-[10px]"></i> Nuevo usuario
      </button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50/50 text-[11px] font-medium uppercase tracking-wider text-slate-400 border-b border-slate-100">
          <tr>
            <th class="px-5 py-3">Nombre</th>
            <th class="px-5 py-3">Email</th>
            <th class="px-5 py-3">Rol</th>
            <th class="px-5 py-3">Estado</th>
            <th class="px-5 py-3 text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr *ngFor="let u of usuarios" class="hover:bg-slate-50/50 transition-colors">
            <td class="px-5 py-3 font-medium text-slate-900">
              <div class="flex items-center gap-2.5">
                <div class="w-7 h-7 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center font-semibold text-[10px]">
                  {{ u.nombre.charAt(0) }}
                </div>
                <span>{{ u.nombre }}</span>
              </div>
            </td>
            <td class="px-5 py-3 text-slate-500">{{ u.email }}</td>
            <td class="px-5 py-3">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-700">
                {{ u.roles?.nombre || ('Rol #' + u.rol_id) }}
              </span>
            </td>
            <td class="px-5 py-3">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-medium"
                [ngClass]="u.activo ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700'">
                <span class="w-1.5 h-1.5 rounded-full" [ngClass]="u.activo ? 'bg-emerald-500' : 'bg-rose-500'"></span>
                {{ u.activo ? 'Activo' : 'Inactivo' }}
              </span>
            </td>
            <td class="px-5 py-3 text-right whitespace-nowrap">
              <div class="inline-flex items-center gap-0.5">
                <button (click)="editarUsuarioModal(u)" title="Editar" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:bg-slate-100 rounded-md transition-colors">
                  <i class="fa-solid fa-pen text-[11px]"></i>
                </button>
                <button (click)="abrirModalEliminar(u)" [attr.aria-label]="'Eliminar usuario ' + u.nombre" title="Eliminar" class="w-7 h-7 flex items-center justify-center text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-md transition-colors">
                  <i class="fa-solid fa-trash text-[11px]"></i>
                </button>
              </div>
            </td>
          </tr>

          <tr *ngIf="usuarios.length === 0">
            <td colspan="5" class="px-5 py-12 text-center text-slate-400">
              <div class="flex flex-col items-center justify-center space-y-2">
                <i class="fa-solid fa-users-slash text-xl text-slate-300"></i>
                <p class="text-xs">No hay usuarios registrados.</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</main>
</file>

<file path="src/app/users/users.ts">
import { Component, OnInit, ChangeDetectorRef } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { IntrusionService } from '../services/intrusion.service';
import { HeaderService } from '../services/header.service';
import { Usuario, Rol } from '../models/intrusion.model';
import { ConfirmationDialogComponent } from '../shared/confirmation-dialog/confirmation-dialog';

@Component({
  selector: 'app-users',
  standalone: true,
  imports: [CommonModule, FormsModule, ConfirmationDialogComponent],
  styleUrl: './users.css',
  templateUrl: './users.html',
})
export class UsersComponent implements OnInit {
  usuarios: Usuario[] = [];
  roles: Rol[] = [];

  usuarioForm: Usuario = {
    nombre: '',
    email: '',
    password: '',
    rol_id: 1,
    activo: true
  };

  editando: boolean = false;
  usuarioIdEditando?: number;
  mostrarModal: boolean = false;
  usuarioAEliminar: Usuario | null = null;
  nombreConfirmacionEliminacion = '';
  eliminandoUsuario = false;
  confirmacionEdicion = false;
  actualizandoUsuario = false;

  mensajeAlerta: string = '';
  tipoAlerta: 'success' | 'error' = 'success';
  private alertaTimer: any;

  constructor(
    private intrusionService: IntrusionService,
    private headerService: HeaderService,
    private cdr: ChangeDetectorRef // 👈 Inyección del detector de cambios
  ) {}

  ngOnInit(): void {
    this.headerService.cambiarHeader(
      'Gestión De Usuario',
      'Administración de Accesos y Credenciales'
    );

    this.cargarDatos();
  }

  cargarDatos(): void {
    this.intrusionService.obtenerUsuarios().subscribe({
      next: (data) => {
        console.log('DATOS ASIGNADOS A LA TABLA:', data);
        this.usuarios = data;
        this.cdr.detectChanges(); // 👈 Fuerza el pintado inmediato en la vista
      },
      error: (err) => console.error('Error al cargar usuarios:', err)
    });

    this.intrusionService.obtenerRoles().subscribe({
      next: (data) => {
        this.roles = data;
        this.cdr.detectChanges();
      },
      error: (err) => console.error('Error al cargar roles:', err)
    });
  }

  abrirModalCrear(): void {
    this.resetForm();
    this.mostrarModal = true;
  }

  editarUsuarioModal(usuario: Usuario): void {
    this.editando = true;
    this.usuarioIdEditando = usuario.id;
    this.usuarioForm = {
      nombre: usuario.nombre,
      email: usuario.email,
      rol_id: usuario.rol_id,
      activo: usuario.activo ?? true
    };
    this.mostrarModal = true;
  }

  cerrarModal(): void {
    this.mostrarModal = false;
    this.confirmacionEdicion = false;
    this.resetForm();
  }

  guardarUsuario(): void {
    if (this.editando && this.usuarioIdEditando !== undefined) {
      this.confirmacionEdicion = true;
    } else {
      this.intrusionService.crearUsuario(this.usuarioForm).subscribe({
        next: () => {
          this.cerrarModal();
          this.cargarDatos();
          this.mostrarAlerta('Usuario creado exitosamente', 'success');
        },
        error: (err) => {
          console.error('Error al crear usuario:', err);
          this.mostrarAlerta('Error al crear el usuario. Verifica los datos.', 'error');
        }
      });
    }
  }

  confirmarAccion(): void {
    if (this.usuarioAEliminar) {
      this.confirmarEliminacion();
      return;
    }

    if (this.confirmacionEdicion) this.confirmarEdicion();
  }

  cerrarConfirmacion(): void {
    if (this.eliminandoUsuario || this.actualizandoUsuario) return;

    if (this.usuarioAEliminar) {
      this.cerrarModalEliminar();
    } else {
      this.confirmacionEdicion = false;
    }
  }

  private confirmarEdicion(): void {
    if (!this.editando || this.usuarioIdEditando === undefined || this.actualizandoUsuario) return;

    this.actualizandoUsuario = true;
    this.intrusionService.actualizarUsuario(this.usuarioIdEditando, this.usuarioForm).subscribe({
      next: () => {
        this.actualizandoUsuario = false;
        this.confirmacionEdicion = false;
        this.cerrarModal();
        this.cargarDatos();
        this.mostrarAlerta('Usuario actualizado correctamente', 'success');
      },
      error: (err) => {
        console.error('Error al actualizar usuario:', err);
        this.actualizandoUsuario = false;
        this.mostrarAlerta('Error al actualizar el usuario', 'error');
      }
    });
  }

  abrirModalEliminar(usuario: Usuario): void {
    if (usuario.id === undefined) {
      console.error('No se puede eliminar un usuario sin identificador.');
      this.mostrarAlerta('No se puede eliminar este usuario porque no tiene identificador.', 'error');
      return;
    }

    this.usuarioAEliminar = usuario;
    this.nombreConfirmacionEliminacion = '';
  }

  cerrarModalEliminar(): void {
    if (this.eliminandoUsuario) return;

    this.usuarioAEliminar = null;
    this.nombreConfirmacionEliminacion = '';
  }

  get puedeConfirmarEliminacion(): boolean {
    const nombreEsperado = this.usuarioAEliminar?.nombre.trim().toLocaleLowerCase();
    const nombreIngresado = this.nombreConfirmacionEliminacion.trim().toLocaleLowerCase();

    return !!nombreEsperado
      && nombreIngresado === nombreEsperado
      && !this.eliminandoUsuario;
  }

  confirmarEliminacion(): void {
    if (!this.puedeConfirmarEliminacion || this.usuarioAEliminar?.id === undefined) return;

    const usuarioId = this.usuarioAEliminar.id;
    this.eliminandoUsuario = true;

    this.intrusionService.eliminarUsuario(usuarioId).subscribe({
      next: () => {
        this.eliminandoUsuario = false;
        this.cerrarModalEliminar();
        this.cargarDatos();
        this.mostrarAlerta('Usuario eliminado correctamente', 'success');
      },
      error: (err) => {
        console.error('Error al eliminar usuario:', err);
        this.eliminandoUsuario = false;
        this.mostrarAlerta('No se pudo eliminar el usuario', 'error');
      }
    });
  }

  resetForm(): void {
    this.editando = false;
    this.usuarioIdEditando = undefined;
    this.usuarioForm = {
      nombre: '',
      email: '',
      password: '',
      rol_id: 1,
      activo: true
    };
  }

  mostrarAlerta(mensaje: string, tipo: 'success' | 'error'): void {
    this.mensajeAlerta = mensaje;
    this.tipoAlerta = tipo;

    if (this.alertaTimer) clearTimeout(this.alertaTimer);

    this.alertaTimer = setTimeout(() => {
      this.mensajeAlerta = '';
    }, 3500);
  }
}
