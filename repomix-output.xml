              </div>

              <div class="flex items-center gap-1.5">
                <button type="button" (click)="editarDispositivo(dispositivo)" class="px-2.5 py-1.5 rounded-xl font-medium text-xs bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors flex items-center gap-1 cursor-pointer border border-slate-700">
                  <i class="fa-solid fa-pen text-[10px]"></i>
                  <span>Editar</span>
                </button>
                <button type="button" (click)="abrirConfirmacionEliminar(dispositivo)" class="px-2.5 py-1.5 rounded-xl font-medium text-xs bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 transition-colors flex items-center gap-1 cursor-pointer border border-rose-500/20">
                  <i class="fa-solid fa-trash text-[10px]"></i>
                  <span>Eliminar</span>
                </button>
              </div>
            </div>

          </div>

          <!-- COLUMNA DERECHA: Imagen del Microcontrolador -->
          <div class="w-full md:w-95 h-55 rounded-xl shrink-0 flex items-center justify-center shadow-inner relative overflow-hidden group self-center md:self-center">
            <img 
              *ngIf="dispositivo.imagen_url" 
              [src]="dispositivo.imagen_url" 
              [alt]="dispositivo.nombre"
              class="max-w-full max-h-full object-contain filter group-hover:scale-102 transition-transform duration-300" 
            />
            <i *ngIf="!dispositivo.imagen_url" class="fa-solid fa-microchip text-slate-600 text-3xl"></i>
          </div>

        </div>
      </ng-container>

      <!-- TARJETAS NORMALES -->
     <!-- TARJETAS NORMALES -->
      <ng-template #tarjetaNormal>
        <div class="h-full flex flex-col justify-between space-y-4">

          <!-- Bloque Superior (Cabecera, Imagen, Ubicación y Descripción) -->
          <div class="space-y-3">
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1.5 flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-block px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
                    {{ dispositivo.tipo || 'Sensor' }}
                  </span>
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold"
                        [ngClass]="dispositivo.activo ? 'bg-emerald-50 text-emerald-700 border border-emerald-200/60' : 'bg-slate-100 text-slate-500 border border-slate-200'">
                    {{ dispositivo.activo ? 'Activo' : 'Inactivo' }}
                  </span>
                </div>
                
                <h4 class="text-xs font-bold text-slate-900 leading-snug truncate">
                  {{ dispositivo.nombre }}
                </h4>
              </div>

              <!-- Imagen / Icono del Dispositivo -->
              <div class="w-20 h-16 rounded-xl bg-slate-50 border border-slate-200/60 shrink-0 flex items-center justify-center relative overflow-hidden group p-1">
                <img 
                  *ngIf="dispositivo.imagen_url" 
                  [src]="dispositivo.imagen_url" 
                  [alt]="dispositivo.nombre"
                  class="max-w-full max-h-full object-contain filter group-hover:scale-105 transition-transform duration-300"
                />
                <i *ngIf="!dispositivo.imagen_url" class="fa-solid fa-microchip text-slate-400 text-base"></i>
              </div>
            </div>
            
            <p class="text-[11px] text-slate-500 flex items-center gap-1.5">
              <i class="fa-solid fa-location-dot text-slate-400"></i> 
              <span class="truncate">{{ dispositivo.ubicacion || 'Panel de Control' }}</span>
            </p>

            <p class="text-[11px] p-2.5 rounded-xl leading-relaxed bg-slate-50/60 text-slate-600 border border-slate-100">
              {{ dispositivo.descripcion_tecnica || 'Componente integrado en el sistema perimetral.' }}
            </p>
          </div>

          <!-- Bloque Inferior (Pines, Puertos y Botones - Empujado al fondo) -->
          <div class="pt-3 border-t border-slate-100 text-xs space-y-2.5">
            <div class="flex items-center justify-between gap-3">
              <span class="text-slate-400 font-medium text-[11px]">Pin / Conexión:</span>
              <span class="font-mono font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-800 text-[11px] border border-slate-200">
                {{ dispositivo.pin_conexion || 'N/A' }}
              </span>
            </div>

            <div class="flex items-center justify-between pt-0.5">
              <span class="font-mono text-[11px] text-slate-500">
                COM: {{ dispositivo.puerto_com || 'COM4' }}
              </span>

              <div class="flex items-center gap-1.5">
                <button type="button" (click)="editarDispositivo(dispositivo)" class="px-2 py-1.5 rounded-xl font-medium text-[11px] text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors flex items-center gap-1 cursor-pointer border border-slate-200">
                  <i class="fa-solid fa-pen text-[9px]"></i>
                  <span>Editar</span>
                </button>
                <button type="button" (click)="abrirConfirmacionEliminar(dispositivo)" class="px-2 py-1.5 rounded-xl font-medium text-[11px] bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors flex items-center gap-1 cursor-pointer border border-rose-200/60">
                  <i class="fa-solid fa-trash text-[9px]"></i>
                  <span>Eliminar</span>
                </button>
              </div>
            </div>
          </div>

        </div>
      </ng-template>

    </article>
  </div>

  <!-- Diálogo de Confirmación Global -->
  <app-confirmation-dialog
    [open]="accionConfirmacion !== null"
    [title]="accionConfirmacion === 'create'
      ? 'Confirmar creación'
      : accionConfirmacion === 'edit'
        ? 'Confirmar edición'
        : 'Eliminar dispositivo'"
    [message]="accionConfirmacion === 'create'
      ? '¿Deseas registrar este dispositivo en el sistema?'
      : accionConfirmacion === 'edit'
        ? '¿Deseas guardar los cambios realizados?'
        : 'Esta acción es permanente. Escribe el nombre del dispositivo para confirmar su eliminación.'"
    [details]="accionConfirmacion === 'delete'
      ? (dispositivoAEliminar?.nombre ?? '')
      : (dispositivoForm.nombre ?? '')"
    [confirmLabel]="procesando
      ? (accionConfirmacion === 'delete' ? 'Eliminando…' : 'Guardando…')
      : accionConfirmacion === 'create'
        ? 'Registrar'
        : accionConfirmacion === 'edit'
          ? 'Guardar cambios'
          : 'Eliminar dispositivo'"
    [confirmationText]="accionConfirmacion === 'delete' ? (dispositivoAEliminar?.nombre ?? null) : null"
    [confirmationPrompt]="dispositivoAEliminar
      ? 'Escribe ' + dispositivoAEliminar.nombre + ' para confirmar'
      : ''"
    [(confirmationValue)]="nombreConfirmacionEliminacion"
    [tone]="accionConfirmacion === 'delete'
      ? 'danger'
      : accionConfirmacion === 'create'
        ? 'success'
        : 'primary'"
    [busy]="procesando"
    (confirmed)="confirmarAccion()"
    (cancelled)="cerrarConfirmacion()">
  </app-confirmation-dialog>

</main>
</file>

