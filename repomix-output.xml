import { ChangeDetectorRef, Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';
import { IntrusionService } from '../services/intrusion.service';
import { Dispositivo } from '../models/intrusion.model';
import { HeaderService } from '../services/header.service';

@Component({
  standalone: true,
  imports: [CommonModule],
  selector: 'app-devices',
  styleUrl: './devices.css',
  templateUrl: './devices.html',
})
export class Devices implements OnInit {
  dispositivos: Dispositivo[] = [];
  cargando = false;
  error = '';

  constructor(
    private intrusionService: IntrusionService,
    private headerService: HeaderService,
    private cdr: ChangeDetectorRef
  ) {}

  ngOnInit(): void {
    this.headerService.cambiarHeader(
      'Dispositivos',
      'Dispositivos registrados en el sistema'
    );
    this.cargarDispositivos();
  }

  cargarDispositivos(): void {
    this.cargando = true;
    this.error = '';

    this.intrusionService.obtenerDispositivos().subscribe({
      next: (dispositivos) => {
        this.dispositivos = dispositivos;
        this.cargando = false;
        this.cdr.detectChanges();
      },
      error: (err) => {
        console.error('Error al cargar dispositivos:', err);
        this.error = 'No se pudieron cargar los dispositivos. Verifica la conexión con la API.';
        this.cargando = false;
        this.cdr.detectChanges();
      }
    });
  }
}
