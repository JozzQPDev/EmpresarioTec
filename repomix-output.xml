    {{ error }}
  </div>
  <div class="space-y-6">

    <!-- BARRA DE ACCIONES Y FILTROS -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200/70 shadow-xs">

      <!-- Filtros por tipo de log -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider mr-1.5">Filtrar:</span>

        <button
          (click)="filtrar('TODOS')"
          [class.bg-slate-900]="filtroNivel === 'TODOS'"
          [class.text-white]="filtroNivel === 'TODOS'"
          [class.bg-slate-100]="filtroNivel !== 'TODOS'"
          [class.text-slate-600]="filtroNivel !== 'TODOS'"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all">
          Todos
        </button>

        <button
          (click)="filtrar('SUCCESS')"
          [class.bg-emerald-600]="filtroNivel === 'SUCCESS'"
          [class.text-white]="filtroNivel === 'SUCCESS'"
          [class.bg-emerald-50]="filtroNivel !== 'SUCCESS'"
          [class.text-emerald-700]="filtroNivel !== 'SUCCESS'"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all">
          Success
        </button>

        <button
          (click)="filtrar('WARNING')"
          [class.bg-amber-500]="filtroNivel === 'WARNING'"
          [class.text-white]="filtroNivel === 'WARNING'"
          [class.bg-amber-50]="filtroNivel !== 'WARNING'"
          [class.text-amber-700]="filtroNivel !== 'WARNING'"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all">
          Warning
        </button>

        <button
          (click)="filtrar('ERROR')"
          [class.bg-rose-600]="filtroNivel === 'ERROR'"
          [class.text-white]="filtroNivel === 'ERROR'"
          [class.bg-rose-50]="filtroNivel !== 'ERROR'"
          [class.text-rose-700]="filtroNivel !== 'ERROR'"
          class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all">
          Error
        </button>
      </div>

      <!-- Botones de Acción (Refrescar) -->
      <div class="flex items-center gap-2">
        <button
          (click)="cargarLogs()"
          class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-medium transition-colors"
          title="Actualizar registros">
          <i class="fa-solid fa-rotate-right text-[11px]" [class.animate-spin]="cargando"></i>
          <span>Actualizar</span>
        </button>
      </div>

    </div>

    <!-- TABLA DE LOGS -->
    <div class="bg-white rounded-xl border border-slate-200/70 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50/50 border-b border-slate-100 text-slate-400 text-[11px] font-medium uppercase tracking-wider">
              <th class="py-3 px-5">Marca de Tiempo</th>
              <th class="py-3 px-5">Nivel</th>
              <th class="py-3 px-5">Módulo</th>
              <th class="py-3 px-5">Descripción del Registro</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-600">

            @for (log of logsFiltrados; track log.id) {
              <tr class="hover:bg-slate-50/50 transition-colors">
                <td class="py-3 px-5 font-mono text-slate-400 text-[11px] whitespace-nowrap">{{ log.timestamp }}</td>
                <td class="py-3 px-5 whitespace-nowrap">
                  <span [ngClass]="{
                    'bg-emerald-50 text-emerald-700 border-emerald-200/60': log.nivel === 'SUCCESS',
                    'bg-amber-50 text-amber-700 border-amber-200/60': log.nivel === 'WARNING',
                    'bg-rose-50 text-rose-700 border-rose-200/60': log.nivel === 'ERROR'
                  }" class="px-2 py-0.5 rounded text-[10px] font-semibold border tracking-wide uppercase">
                    {{ log.nivel }}
                  </span>
                </td>
                <td class="py-3 px-5 font-medium text-slate-800 whitespace-nowrap">{{ log.modulo }}</td>
                <td class="py-3 px-5 text-slate-600">{{ log.mensaje }}</td>
              </tr>
            }

            @if (cargando) {
              <tr>
                <td colspan="4" class="text-center py-12 text-slate-400">
                  Cargando registros desde la API...
                </td>
              </tr>
            }

            @if (!cargando && logsFiltrados.length === 0) {
              <tr>
                <td colspan="4" class="text-center py-12 text-slate-400">
                  <div class="flex flex-col items-center justify-center space-y-2">
                    <i class="fa-regular fa-folder-open text-xl text-slate-300"></i>
                    <p class="text-xs">No se encontraron registros para el filtro seleccionado.</p>
                  </div>
                </td>
              </tr>
            }

          </tbody>
        </table>
      </div>
    </div>

  </div>
</main>
