<file path="src/app/dashboard/dashboard.html">
<boneyard-skeleton
  class="block"
  name="dashboard"
  [loading]="cargando"
  [initialBones]="bonesCarga"
  color="#cbd5e1"
  darkColor="#475569"
  animate="pulse"
  select="viewport">
<main class="flex-1 overflow-y-auto px-7 py-8 font-sans antialiased">
  <div class="max-w-[1600px] space-y-8">

    <!-- Error de carga -->
    <div *ngIf="error" role="alert"
         class="flex items-center justify-between gap-4 border-l-2 border-rose-500 pl-3 text-xs text-rose-700">
      <span>{{ error }}</span>
      <button type="button" (click)="cargarDatos()" class="shrink-0 underline underline-offset-4 cursor-pointer">Reintentar</button>
    </div>

    <ng-container *ngIf="!cargando">

      <!-- Estado vacío compartido por las tarjetas de gráficos -->
      <ng-template #sinDatos>
        <div class="grid h-48 place-items-center text-center text-xs text-slate-400">
          Aún no hay alertas para graficar.
        </div>
      </ng-template>


      <!-- ============ 2. SECCIÓN DE INDICADORES PRINCIPALES (KPI Grid) ============ -->
      <section aria-label="Indicadores principales" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

                <!-- Tarjeta 2: Alertas en 7 días -->
        <article class="p-5 ">
        <div>
          <p class="text-xs text-slate-500">Estado del perímetro</p>
          <div class="mt-2 flex items-center gap-3">
            <span class="relative flex h-3 w-3">
              <span *ngIf="nivelActual === 'critico'"
                    class="absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-70 animate-ping motion-reduce:animate-none"></span>
              <span class="relative inline-flex h-3 w-3 rounded-full"
                    [ngClass]="{
                      'bg-emerald-500': nivelActual === 'seguro',
                      'bg-amber-500':   nivelActual === 'advertencia',
                      'bg-rose-500':    nivelActual === 'critico',
                      'bg-slate-300':   nivelActual === 'desconectado'
                    }"></span>
            </span>
            <h1 class="text-xl font-semibold tracking-tight sm:text-2xl"
                [ngClass]="{
                  'text-slate-900': nivelActual === 'seguro' || nivelActual === 'desconectado',
                  'text-amber-700': nivelActual === 'advertencia',
                  'text-rose-700':  nivelActual === 'critico'
                }">
              {{ nivelActual === 'seguro' ? 'Zona segura'
                : nivelActual === 'advertencia' ? 'Presencia detectada'
                : nivelActual === 'critico' ? 'Intrusión'
                : 'Sin conexión con el Arduino' }}
            </h1>
          </div>
          <div class="mt-2 max-w-prose space-y-1 text-xs text-slate-500">
            <ng-container *ngIf="zonaActual || descripcionActual; else mensajeSimple">
              <p *ngIf="zonaActual"><span class="font-medium text-slate-600">Zona:</span> {{ zonaActual }}</p>
              <p *ngIf="descripcionActual"><span class="font-medium text-slate-600">Descripción:</span> {{ descripcionActual }}</p>
            </ng-container>
            <ng-template #mensajeSimple>
              <p>{{ mensajeEstado || 'Monitoreando barreras físicas…' }}</p>
            </ng-template>
          </div>
        </div>
        </article>

        <!-- Tarjeta 1: Intrusiones Acumuladas -->
        <article class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs transition-all hover:border-slate-300">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Intrusiones acumuladas</p>
              <p class="mt-2 text-xl font-bold tracking-tight text-slate-900">{{ estadoActual.intrusiones_totales }}</p>
            </div>
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-rose-50 text-rose-600 border border-rose-100">
              <i class="fa-solid fa-triangle-exclamation text-base" aria-hidden="true"></i>
            </span>
          </div>
          <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">
            Registro total histórico del sistema
          </div>
        </article>



        <!-- Tarjeta 3: Duración Media -->
        <article class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs transition-all hover:border-slate-300">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Duración media</p>
              <p class="mt-2 text-xl font-bold tracking-tight text-slate-900">
                {{ duracionMedia === null ? '—' : formatearDuracion(duracionMedia) }}
              </p>
            </div>
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-violet-50 text-violet-600 border border-violet-100">
              <i class="fa-regular fa-clock text-base" aria-hidden="true"></i>
            </span>
          </div>
          <div class="mt-4 border-t border-slate-100 pt-3 text-xs text-slate-500">
            Basada en {{ historialAlertasBD.length }} {{ historialAlertasBD.length === 1 ? 'registro' : 'registros' }}
          </div>
        </article>

        <!-- Tarjeta 4: Dispositivos Registrados -->
        <article class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-2xs transition-all hover:border-slate-300">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Dispositivos registrados</p>
              <p class="mt-2 text-xl font-bold tracking-tight text-slate-900">{{ totalDispositivos }}</p>
            </div>
            <span class="grid h-10 w-10 place-items-center rounded-xl bg-sky-50 text-sky-600 border border-sky-100">
              <i class="fa-solid fa-microchip text-base" aria-hidden="true"></i>
            </span>
          </div>
          <div class="mt-4 truncate border-t border-slate-100 pt-3 text-xs text-slate-500">
            Principal: {{ estadoActual.dispositivo || 'Arduino Mega 2560' }}
          </div>
        </article>

      </section>

      <!-- ============ 3. GRÁFICOS (cuadrícula 2 x 2, tarjetas idénticas) ============ -->
      <section aria-label="Análisis de alertas" class="grid gap-6 lg:grid-cols-2">

        <!-- 3a. Últimos 7 días -->
        <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5">
          <header>
            <h2 class="text-sm font-semibold text-slate-900">Últimos 7 días</h2>
            <p class="mt-0.5 text-xs text-slate-500">Alertas por día.</p>
          </header>

          <div class="mt-5 flex-1 overflow-visible">
            <ng-container *ngIf="historialAlertasBD.length > 0; else sinDatos">
              <div class="h-48 overflow-visible">
                <div class="flex h-36 items-end gap-3 overflow-visible border-b border-slate-200" role="img"
                     [attr.aria-label]="alertas7Dias + ' alertas en los últimos 7 días'">
                  <div *ngFor="let d of alertasPorDia; let i = index"
                       class="group relative z-0 flex h-full flex-1 items-end justify-center hover:z-30 focus:z-30"
                       tabindex="0"
                       [attr.aria-label]="d.fechaCompleta + ': ' + d.advertencias + ' advertencias, ' + d.criticos + ' críticas'">
                    <div
                      role="tooltip"
                      class="pointer-events-none absolute bottom-full z-20 mb-2 hidden min-w-max rounded-lg bg-slate-900 px-3 py-2 text-left text-xs text-white shadow-lg group-hover:block group-focus:block"
                      [ngClass]="i === 0 ? 'left-0' : i === alertasPorDia.length - 1 ? 'right-0' : 'left-1/2 -translate-x-1/2'">
                      <p class="font-semibold">{{ d.fechaCompleta }}</p>
                      <p class="mt-1 flex items-center gap-1.5 text-slate-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                        {{ d.advertencias }} {{ d.advertencias === 1 ? 'advertencia' : 'advertencias' }}
                      </p>
                      <p class="mt-0.5 flex items-center gap-1.5 text-slate-300">
                        <span class="h-1.5 w-1.5 rounded-full bg-rose-400"></span>
                        {{ d.criticos }} {{ d.criticos === 1 ? 'crítica' : 'críticas' }}
                      </p>
                    </div>
                    <div
                         class="dashboard-chart-bar-enter flex w-full max-w-10 flex-col justify-end overflow-hidden rounded-t-md"
                         [style.animation-delay]="(i * 70) + 'ms'"
                         [style.height.%]="d.advPct + d.critPct"
                         [style.min-height.px]="d.total ? 4 : 0">
                      <span *ngIf="d.criticos > 0" class="block w-full bg-rose-500"
                            [style.height.%]="(d.criticos / d.total) * 100"></span>
                      <span *ngIf="d.advertencias > 0" class="block w-full bg-amber-500"
                            [style.height.%]="(d.advertencias / d.total) * 100"></span>
                    </div>
                  </div>
                </div>
                <div class="mt-2 flex h-10 gap-3">
                  <div *ngFor="let d of alertasPorDia" class="flex-1 text-center">
                    <p class="text-xs capitalize text-slate-500">{{ d.etiqueta }}</p>
                    <p class="text-xs font-medium text-slate-900">{{ d.total }}</p>
                  </div>
                </div>
              </div>
            </ng-container>
          </div>

          <footer class="mt-5 flex gap-6 border-t border-slate-100 pt-3 text-xs text-slate-500">
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-amber-500"></span>Advertencia</span>
            <span class="flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-rose-500"></span>Crítico</span>
          </footer>
        </article>

        <!-- 3b. Actividad por hora -->
        <article class="relative z-0 flex flex-col overflow-visible rounded-xl border border-slate-200 bg-white p-5 hover:z-20 focus-within:z-20">
          <header>
            <h2 class="text-sm font-semibold text-slate-900">Actividad por hora</h2>
            <p class="mt-0.5 text-xs text-slate-500">Hora de Perú (UTC−5) · alertas por hora.</p>
          </header>

          <div class="mt-5 flex-1 overflow-visible">
            <ng-container *ngIf="historialAlertasBD.length > 0; else sinDatos">
              <div class="h-48 overflow-visible">
                <div class="flex h-36 items-end gap-0.5 overflow-visible border-b border-slate-200" role="img"
                     aria-label="Alertas registradas por hora del día">
                  <div *ngFor="let h of alertasPorHora; let i = index"
                       class="group relative z-0 flex h-full flex-1 items-end hover:z-30 focus:z-30"
                       tabindex="0"
                       [attr.aria-label]="formatearHora(h.hora) + ', ' + h.total + (h.total === 1 ? ' alerta' : ' alertas')">
                    <div
                      role="tooltip"
                      class="pointer-events-none absolute bottom-full z-20 mb-2 hidden min-w-max rounded-lg bg-slate-900 px-3 py-2 text-left text-xs text-white shadow-lg group-hover:block group-focus:block"
                      [ngClass]="h.hora === 0 ? 'left-0' : h.hora === 23 ? 'right-0' : 'left-1/2 -translate-x-1/2'">
                      <p class="font-semibold">{{ formatearHora(h.hora) }}</p>
                      <p class="mt-0.5 text-slate-300">
                        {{ h.total }} {{ h.total === 1 ? 'alerta' : 'alertas' }}
                      </p>
                    </div>
                    <div
                         class="dashboard-chart-bar-enter w-full rounded-t-sm"
                         [style.animation-delay]="(i * 35) + 'ms'"
                         [ngClass]="h.hora === horaPico ? 'bg-slate-900' : 'bg-slate-300'"
                         [style.height.%]="h.pct"
                         [style.min-height.px]="h.total ? 3 : 0"></div>
                  </div>
                </div>
                <div class="mt-2 flex h-10 justify-between text-xs text-slate-500">
                  <span>12:00 AM</span><span>06:00 AM</span><span>12:00 PM</span><span>06:00 PM</span><span>11:00 PM</span>
                </div>
              </div>
            </ng-container>
          </div>

          <footer class="mt-5 border-t border-slate-100 pt-3 text-xs text-slate-500">
            <ng-container *ngIf="horaPico !== null; else sinPico">
              Mayor actividad a las <span class="font-mono text-slate-900">{{ formatearHora(horaPico) }}</span>
            </ng-container>
            <ng-template #sinPico>Sin hora pico todavía.</ng-template>
          </footer>
        </article>

        <!-- 3c. Tipos de evento -->
        <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5">
          <header>
            <h2 class="text-sm font-semibold text-slate-900">Tipos de evento</h2>
            <p class="mt-0.5 text-xs text-slate-500">Cuántas veces ocurrió cada uno.</p>
          </header>

          <div class="mt-5 flex-1">
            <ul *ngIf="historialAlertasBD.length > 0; else sinDatos" class="space-y-5">
              <li *ngFor="let t of alertasPorTipo; let i = index">
                <div class="flex items-baseline justify-between text-xs">
                  <span class="text-slate-700">{{ t.nombre }}</span>
                  <span class="font-mono text-slate-900">{{ t.total }}</span>
                </div>
                <div class="mt-1.5 h-1.5 rounded-full bg-slate-100">
                  <div
                       class="dashboard-chart-progress-enter h-1.5 rounded-full"
                       [style.animation-delay]="(i * 90) + 'ms'"
                       [ngClass]="getColorBarra(t.codigo)"
                       [style.width.%]="t.pct"></div>
                </div>
              </li>
            </ul>
          </div>

          <footer class="mt-5 border-t border-slate-100 pt-3 text-xs text-slate-500">
            {{ historialAlertasBD.length }} {{ historialAlertasBD.length === 1 ? 'registro' : 'registros' }} en total
          </footer>
        </article>

        <!-- 3d. Distribución por nivel -->
        <article class="relative z-0 flex flex-col overflow-visible rounded-xl border border-slate-200 bg-white p-5 hover:z-20 focus-within:z-20">
          <header>
            <h2 class="text-sm font-semibold text-slate-900">Distribución por nivel</h2>
            <p class="mt-0.5 text-xs text-slate-500">Estados seguros del monitoreo y niveles de las alertas.</p>
          </header>

          <div class="mt-5 flex flex-1 items-center justify-center">
            <ng-container *ngIf="totalEventosClasificados > 0; else sinDatos">
              <div class="flex w-full flex-wrap items-center justify-center gap-8">
                <div class="relative h-48 w-48 shrink-0">
                  <svg class="h-full w-full overflow-visible" viewBox="0 0 120 120"
                       role="img"
                       [attr.aria-label]="'Distribución por nivel: reposo ' + porcentajeSeguro + '%, advertencia ' + porcentajeAdvertencia + '%, crítico ' + porcentajeCritico + '%'">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#f1f5f9" stroke-width="13"></circle>
                    <g transform="rotate(-90 60 60)">
                    <circle *ngIf="porcentajeSeguro > 0" cx="60" cy="60" r="50" fill="none"
                            stroke="#10b981" stroke-width="13" stroke-linecap="butt"
                            [attr.stroke-dasharray]="porcentajeSeguro * 3.1416 + ' 314.16'"
                            stroke-dashoffset="0"
                            class="dashboard-chart-donut-segment-enter"
                            [class.dashboard-chart-donut-segment-active]="nivelDistribucionHover === 'seguro'"
                            (mouseenter)="nivelDistribucionHover = 'seguro'"
                            (mouseleave)="nivelDistribucionHover = null"
                            (focus)="nivelDistribucionHover = 'seguro'"
                            (blur)="nivelDistribucionHover = null"
                            [attr.tabindex]="0"
                            [attr.aria-label]="'Reposo: ' + eventosSeguros + ' eventos, ' + porcentajeSeguro + '%'"></circle>
                    <circle *ngIf="porcentajeAdvertencia > 0" cx="60" cy="60" r="50" fill="none"
                            stroke="#f59e0b" stroke-width="13" stroke-linecap="butt"
                            [attr.stroke-dasharray]="porcentajeAdvertencia * 3.1416 + ' 314.16'"
                            [attr.stroke-dashoffset]="-porcentajeSeguro * 3.1416"
                            class="dashboard-chart-donut-segment-enter"
                            [style.animation-delay]="'90ms'"
                            [class.dashboard-chart-donut-segment-active]="nivelDistribucionHover === 'advertencia'"
                            (mouseenter)="nivelDistribucionHover = 'advertencia'"
                            (mouseleave)="nivelDistribucionHover = null"
                            (focus)="nivelDistribucionHover = 'advertencia'"
                            (blur)="nivelDistribucionHover = null"
                            [attr.tabindex]="0"
                            [attr.aria-label]="'Advertencia: ' + eventosAdvertencia + ' eventos, ' + porcentajeAdvertencia + '%'"></circle>
                    <circle *ngIf="porcentajeCritico > 0" cx="60" cy="60" r="50" fill="none"
                            stroke="#f43f5e" stroke-width="13" stroke-linecap="butt"
                            [attr.stroke-dasharray]="porcentajeCritico * 3.1416 + ' 314.16'"
                            [attr.stroke-dashoffset]="-(porcentajeSeguro + porcentajeAdvertencia) * 3.1416"
                            class="dashboard-chart-donut-segment-enter"
                            [style.animation-delay]="'180ms'"
                            [class.dashboard-chart-donut-segment-active]="nivelDistribucionHover === 'critico'"
                            (mouseenter)="nivelDistribucionHover = 'critico'"
                            (mouseleave)="nivelDistribucionHover = null"
                            (focus)="nivelDistribucionHover = 'critico'"
                            (blur)="nivelDistribucionHover = null"
                            [attr.tabindex]="0"
                            [attr.aria-label]="'Crítico: ' + eventosCriticos + ' eventos, ' + porcentajeCritico + '%'"></circle>
                    </g>
                  </svg>
                  <div class="pointer-events-none absolute inset-7 grid place-content-center rounded-full bg-white text-center">
                    <span class="text-2xl font-bold tracking-tight text-slate-900">{{ totalEventosClasificados }}</span>
                    <span class="text-xs text-slate-500">eventos</span>
                  </div>
                  <div *ngIf="nivelDistribucionHover === 'seguro'"
                       role="tooltip"
                       class="pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 min-w-max -translate-x-1/2 rounded-lg bg-slate-900 px-3 py-2 text-xs text-white shadow-lg">
                    <p class="font-semibold">Reposo</p>
                    <p class="mt-0.5 text-slate-300">{{ eventosSeguros }} {{ eventosSeguros === 1 ? 'evento' : 'eventos' }} · {{ porcentajeSeguro }}%</p>
                  </div>
                  <div *ngIf="nivelDistribucionHover === 'advertencia'"
                       role="tooltip"
                       class="pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 min-w-max -translate-x-1/2 rounded-lg bg-slate-900 px-3 py-2 text-xs text-white shadow-lg">
                    <p class="font-semibold">Advertencia</p>
                    <p class="mt-0.5 text-slate-300">{{ eventosAdvertencia }} {{ eventosAdvertencia === 1 ? 'evento' : 'eventos' }} · {{ porcentajeAdvertencia }}%</p>
                  </div>
                  <div *ngIf="nivelDistribucionHover === 'critico'"
                       role="tooltip"
                       class="pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 min-w-max -translate-x-1/2 rounded-lg bg-slate-900 px-3 py-2 text-xs text-white shadow-lg">
                    <p class="font-semibold">Crítico</p>
                    <p class="mt-0.5 text-slate-300">{{ eventosCriticos }} {{ eventosCriticos === 1 ? 'evento' : 'eventos' }} · {{ porcentajeCritico }}%</p>
                  </div>
                </div>
                <ul class="min-w-36 space-y-3 text-xs">
                  <li class="flex items-center justify-between gap-6">
                    <span class="flex items-center gap-2 text-slate-700">
                      <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                      Reposo
                    </span>
                    <span class="font-mono text-slate-900">{{ eventosSeguros }} · {{ porcentajeSeguro }}%</span>
                  </li>
                  <li class="flex items-center justify-between gap-6">
                    <span class="flex items-center gap-2 text-slate-700">
                      <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                      Advertencia
                    </span>
                    <span class="font-mono text-slate-900">{{ eventosAdvertencia }} · {{ porcentajeAdvertencia }}%</span>
                  </li>
                  <li class="flex items-center justify-between gap-6">
                    <span class="flex items-center gap-2 text-slate-700">
                      <span class="h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                      Crítico
                    </span>
                    <span class="font-mono text-slate-900">{{ eventosCriticos }} · {{ porcentajeCritico }}%</span>
                  </li>
                </ul>
              </div>
            </ng-container>
          </div>

          <footer class="mt-5 border-t border-slate-100 pt-3 text-xs text-slate-500">
            Calculado sobre {{ totalEventosClasificados }} {{ totalEventosClasificados === 1 ? 'evento clasificado' : 'eventos clasificados' }}.
          </footer>
        </article>
      </section>

      <!-- ============ 4. HISTORIAL ============ -->
      <section
        aria-label="Historial de alertas"
        class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
          <div>
            <h2 class="text-sm font-semibold text-slate-900">Historial de alertas</h2>
            <p class="mt-0.5 text-xs text-slate-500">Eventos registrados en la base de datos.</p>
          </div>

          <div class="flex gap-1 text-xs" role="group" aria-label="Filtrar historial">
            <button type="button" (click)="filtroNivel = 'todos'" [attr.aria-pressed]="filtroNivel === 'todos'"
              class="rounded-lg px-3 py-1.5 cursor-pointer"
              [ngClass]="filtroNivel === 'todos' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'">Todas</button>
            <button type="button" (click)="filtroNivel = 'advertencia'" [attr.aria-pressed]="filtroNivel === 'advertencia'"
              class="rounded-lg px-3 py-1.5 cursor-pointer"
              [ngClass]="filtroNivel === 'advertencia' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'">Advertencias</button>
            <button type="button" (click)="filtroNivel = 'critico'" [attr.aria-pressed]="filtroNivel === 'critico'"
              class="rounded-lg px-3 py-1.5 cursor-pointer"
              [ngClass]="filtroNivel === 'critico' ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100'">Críticas</button>
          </div>
        </header>

        <div class="overflow-x-auto">
          <table class="w-full min-w-170 text-left text-xs">
            <thead class="border-b border-slate-100 text-xs text-slate-500">
              <tr>
                <th scope="col" class="px-5 py-3 font-medium">Fecha</th>
                <th scope="col" class="px-5 py-3 font-medium">Estado</th>
                <th scope="col" class="px-5 py-3 font-medium">Mensaje</th>
                <th scope="col" class="px-5 py-3 text-right font-medium">Duración</th>
                <th scope="col" class="px-5 py-3 text-right font-medium">Intrusiones</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr
                *ngFor="let alerta of historialFiltrado; trackBy: trackById"
                class="hover:bg-slate-50">
                <td class="whitespace-nowrap px-5 py-3 font-mono text-xs text-slate-500">
                  {{ alerta.fecha_hora | date:'dd/MM/yyyy HH:mm:ss' }}
                </td>
                <td class="whitespace-nowrap px-5 py-3">
                  <span class="inline-flex rounded-md px-2 py-0.5 text-xs font-medium" [ngClass]="getClaseEstado(alerta.codigo)">
                    {{ getNombreEstado(alerta.codigo) }}
                  </span>
                </td>
                <td class="max-w-xs truncate px-5 py-3 text-slate-800" [attr.title]="alerta.mensaje">{{ alerta.mensaje }}</td>
                <td class="whitespace-nowrap px-5 py-3 text-right text-slate-500">{{ formatearDuracion(alerta.duracion_segundos) }}</td>
                <td class="whitespace-nowrap px-5 py-3 text-right font-medium text-slate-900">{{ alerta.intrusiones }}</td>
              </tr>

              <tr *ngIf="historialFiltrado.length === 0">
                <td colspan="5" class="px-5 py-14 text-center text-xs text-slate-400">
                  {{ historialAlertasBD.length === 0 ? 'Sin alertas registradas.' : 'No hay alertas con este filtro.' }}
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <footer class="border-t border-slate-100 px-5 py-3 text-xs text-slate-500">
          Mostrando {{ historialFiltrado.length }} de {{ historialAlertasBD.length }} registros
        </footer>
      </section>

    </ng-container>
  </div>
</main>

<main fallback class="flex-1 overflow-y-auto px-7 py-8" aria-hidden="true">
  <div class="max-w-[1600px] animate-pulse space-y-8 motion-reduce:animate-none">
    <div class="h-20 rounded-xl bg-slate-200"></div>
    <div class="h-20 rounded-xl bg-slate-200"></div>
    <div class="grid gap-6 lg:grid-cols-2">
      <div *ngFor="let i of [1, 2, 3, 4]" class="h-72 rounded-xl bg-slate-200"></div>
    </div>
    <div class="h-64 rounded-xl bg-slate-200"></div>
  </div>
</main>
