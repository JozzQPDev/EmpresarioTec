          class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-slate-900 text-xs font-semibold text-white"
          aria-hidden="true">
          {{ inicialesUsuario }}
        </span>
        <span class="hidden min-w-0 sm:block">
          <span class="block max-w-40 truncate text-xs font-semibold text-slate-800">{{ usuario.nombre || usuario.email }}</span>
          <span class="block text-[10px] text-slate-500">{{ usuario.rol }}</span>
        </span>
        <i class="fa-solid fa-chevron-down hidden text-[10px] text-slate-400 transition-transform sm:block"
           [class.rotate-180]="menuUsuarioAbierto"
