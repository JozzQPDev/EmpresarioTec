        <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2.5">
          Estado del Perímetro
        </h3>
        <div class="flex items-center gap-2.5 my-1.5">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-slate-900 text-slate-100 shadow-2xs">
              <span
                class="w-1.5 h-1.5 rounded-full"
                [ngClass]="{
                  'bg-emerald-400 animate-pulse': estadoActual.estado !== 0,
                  'bg-rose-500': estadoActual.estado === 0
                }"></span>
              {{ estadoActual.estado === 0 ? 'API Desconectada' : estadoActual.dispositivo }}
            </span>
        </div>
      </div>

      <!-- Descripción contextual del estado -->
      <div class="mt-3 pt-2.5 border-t border-slate-100">
        <p class="text-xs font-medium text-emerald-600" *ngIf="estadoActual.estado === 1">
          Perímetro despejado y seguro.
        </p>
        <p class="text-xs font-medium text-amber-600" *ngIf="estadoActual.estado === 2">
          Presencia detectada. Evaluando umbral...
        </p>
        <p class="text-xs font-semibold text-rose-600 animate-pulse" *ngIf="estadoActual.estado === 3">
          ¡INTRUSO EN LA ZONA! Torreta y buzzer activos.
        </p>
        <p class="text-xs font-semibold text-rose-600 animate-pulse" *ngIf="estadoActual.estado === 4">
          ¡Puerta principal forzada o abierta!
        </p>
        <p class="text-xs font-semibold text-rose-600 animate-pulse" *ngIf="estadoActual.estado === 5">
          ¡Impacto o vibración detectada!
        </p>
        <p class="text-xs font-medium text-slate-400" *ngIf="estadoActual.estado === 0">
          No se puede establecer conexión con la API del sistema.
        </p>
      </div>
    </div>

    <!-- Tarjeta de Contador -->
    <div class="bg-white rounded-xl p-5 shadow-xs border border-slate-200/70 flex flex-col justify-between">
      <div>
        <h3 class="text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
          Intrusiones Registradas
        </h3>
        <div class="text-3xl font-bold text-slate-900 tracking-tight">
          {{ estadoActual.intrusiones_totales }}
        </div>
      </div>
      <div class="mt-3 pt-2.5 border-t border-slate-100">
        <p class="text-xs text-slate-400 font-normal">
          Eventos detectados desde el inicio del sistema
        </p>
      </div>
    </div>

  </div>

  <!-- TABLA DE HISTORIAL DE ALERTAS (DESDE BASE DE DATOS) -->
  <div class="bg-white rounded-xl shadow-xs border border-slate-200/70 overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900">
        Historial de Alertas Críticas <span class="text-xs text-slate-400 font-normal">(Supabase)</span>
      </h2>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-600">
        <thead class="bg-slate-50/50 text-[11px] font-medium uppercase tracking-wider text-slate-400 border-b border-slate-100">
          <tr>
            <th scope="col" class="px-5 py-3">Fecha / Hora</th>
            <th scope="col" class="px-5 py-3">Estado</th>
            <th scope="col" class="px-5 py-3">Mensaje</th>
            <th scope="col" class="px-5 py-3 text-center">Duración</th>
            <th scope="col" class="px-5 py-3 text-right">Intrusiones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <tr *ngFor="let alerta of historialAlertasBD" class="hover:bg-slate-50/50 transition-colors">
            <td class="px-5 py-3 font-mono text-slate-500 whitespace-nowrap">
              {{ alerta.fecha_hora | date:'medium' }}
            </td>
            <td class="px-5 py-3 whitespace-nowrap">
              <span
                class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium"
                [ngClass]="getClaseEstado(alerta.codigo)">
                {{ getNombreEstado(alerta.codigo) }}
              </span>
            </td>
            <td class="px-5 py-3 font-medium text-slate-800">
              {{ alerta.mensaje }}
            </td>
            <td class="px-5 py-3 font-mono text-center text-slate-500 whitespace-nowrap">
              {{ alerta.duracion_segundos }}s
            </td>
            <td class="px-5 py-3 font-semibold text-slate-900 text-right whitespace-nowrap">
              {{ alerta.intrusiones }}
            </td>
          </tr>

          <!-- Fila cuando no hay datos -->
          <tr *ngIf="historialAlertasBD.length === 0">
            <td colspan="5" class="px-5 py-12 text-center text-slate-400">
              <div class="flex flex-col items-center justify-center space-y-2">
                <i class="fa-solid fa-triangle-exclamation text-lg text-slate-300"></i>
                <p class="text-xs">No hay alertas registradas en la base de datos.</p>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</main>
